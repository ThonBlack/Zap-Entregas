# Zap Entregas — modelo de variáveis de ambiente.
#
# Copie pra `.env.local` (na máquina do dev) ou pra `.env` (ao lado do
# docker-compose.yml, em /opt/zap-entregas na VPS) e preencha.
# Este arquivo é o único com TODAS as chaves que o código lê — se você criar uma
# variável nova, acrescente aqui, senão ela some no próximo deploy.
#
# REGRA DO PROJETO: nada de `NEXT_PUBLIC_*` pra valor que depende do ambiente.
# A imagem Docker é construída na máquina do Thon, e tudo que é `NEXT_PUBLIC_`
# fica congelado dentro do pacote JavaScript. Só existe UMA exceção, explicada
# lá embaixo (a chave pública de notificação).
#
# Legenda:  [OBRIGATÓRIA] o app não funciona sem  |  [opcional] tem padrão


# =====================================================================
# Básico
# =====================================================================

# [OBRIGATÓRIA em produção] "production" liga otimizações e esconde mensagens
# internas de erro do usuário. O compose já define; não precisa no .env.
NODE_ENV=production

# [opcional] Caminho do arquivo de banco. O compose já aponta pra
# /app/sqlite.db dentro do container. Local, o padrão é ./sqlite.db.
DATABASE_PATH=./sqlite.db


# =====================================================================
# Segredos — trocar significa derrubar todo mundo (os cookies deixam de valer)
# =====================================================================

# [OBRIGATÓRIA] Assina o cookie de sessão. Mínimo 32 caracteres aleatórios
# (em produção são 64). Vazio ou fraco = qualquer um forja login de admin.
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# [OBRIGATÓRIA] Senha do painel /master (visão do dono do sistema).
MASTER_ADMIN_KEY=


# =====================================================================
# Endereços
# =====================================================================

# [OBRIGATÓRIA] Endereço público do app. É daqui que saem TODOS os links
# absolutos (convite de motoboy, rastreio, retorno do Google). Errado aqui =
# o motoboy recebe link pra localhost.
APP_URL=https://zapentregas.duckdns.org

# [opcional] Mesma coisa, usada em alguns links de convite. Mantida por
# compatibilidade; o código cai em APP_URL e depois no domínio real.
# Apesar do nome NEXT_PUBLIC_, hoje só é lida no servidor.
NEXT_PUBLIC_BASE_URL=https://zapentregas.duckdns.org

# [opcional] Só sobrescreve o endereço de retorno do login com Google. Serve
# pra testar fora do domínio real (ex.: http://localhost:3007). Vazio = APP_URL.
OAUTH_BASE_URL=

# [opcional] Quem pode buscar as fotos de /api/uploads de outro site.
# Padrão: http://localhost:3000 (local) — em produção o compose põe o domínio.
CORS_ORIGIN=https://zapentregas.duckdns.org


# =====================================================================
# Quem pode criar conta
# =====================================================================

# [opcional] Código que libera a opção "Sou Lojista" em /register. A tela só
# mostra a opção com ?convite_lojista=<este código>, e a action confere de novo.
# VAZIO = ninguém se cadastra como lojista (é o padrão e o certo hoje);
# quem cria lojista é o admin, em /admin/users/new.
REGISTER_SHOPKEEPER_CODE=


# =====================================================================
# Mapas — são DUAS chaves diferentes do Google e elas não se misturam
# =====================================================================

# [opcional] Chave do SERVIDOR: achar o endereço no mapa (geocode) e as
# sugestões do campo de endereço. Nunca vai pro navegador.
# Vazia = o app usa OpenStreetMap/ViaCEP, que erram mais em Uberaba.
GOOGLE_MAPS_API_KEY=

# [opcional] Chave do NAVEGADOR: desenha o mapa da conferência e do rastreio
# (Maps JavaScript API). Aparece no HTML da página, então PRECISA estar
# restrita por site no console do Google. Vazia = o mapa cai no OpenStreetMap.
GOOGLE_MAPS_BROWSER_KEY=


# =====================================================================
# Login com Google — vazio = o botão nem aparece na tela
# =====================================================================

# [opcional, mas os dois juntos] Credenciais do projeto no console do Google.
# A URL de retorno cadastrada lá tem que ser <APP_URL>/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# =====================================================================
# Notificação no celular do motoboy (push / VAPID)
# =====================================================================
# Gerar o par: npx web-push generate-vapid-keys

# [opcional, mas os três juntos] Sem eles não sai notificação de corrida nova.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato exigido pelo protocolo, ex.: mailto:thonblack7@gmail.com
VAPID_SUBJECT=

# [ATENÇÃO — a exceção da regra] Esta é a ÚNICA variável embutida no pacote
# JavaScript durante o build, porque o navegador precisa dela pra se inscrever.
# Tem que ser IGUAL à VAPID_PUBLIC_KEY acima, e é passada no build:
#   docker build --build-arg NEXT_PUBLIC_VAPID_PUBLIC_KEY=<mesma chave> ...
# O deploy.sh lê daqui e ABORTA se estiver vazia. Se ficar vazia ou diferente,
# o container sobe verde, o log fica limpo e a notificação nunca chega.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=


# =====================================================================
# Iframe do caixa (PDV do EpicStore)
# =====================================================================

# [opcional] Domínios, separados por ESPAÇO, que podem embutir a tela
# /confirmar/<token> dentro de um quadro. Ex.:
#   PDV_FRAME_ANCESTORS=https://vaporfume.shop https://epicstore.duckdns.org
# Vazio = só o próprio site, e o caixa do EpicStore para de conferir corrida.
PDV_FRAME_ANCESTORS=


# =====================================================================
# Aplicativo Android (TWA)
# =====================================================================
# Alimentam /.well-known/assetlinks.json — é o que faz o app abrir SEM a barra
# de endereço do Chrome à mostra. Lidos em tempo de execução: dá pra mudar no
# .env e reiniciar o container, sem reconstruir a imagem.

# [opcional] Nome do pacote publicado.
ANDROID_PACKAGE_NAME=shop.vaporfume.zapentregas

# [opcional] Impressões digitais (SHA-256) das chaves que assinam o app,
# separadas por vírgula. Ao publicar na Play Store é obrigatório acrescentar
# também a do Play App Signing (o Google reassina o app com outra chave).
ANDROID_CERT_FINGERPRINTS=


# =====================================================================
# E-mail (SMTP) — hoje NÃO é usado
# =====================================================================
# O "esqueci a senha" manda falar com a loja em vez de prometer um e-mail que
# não sairia. Deixar vazio não quebra nada.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=


# =====================================================================
# Só pra scripts da pasta scripts/ — NÃO precisam estar no .env do servidor
# =====================================================================

# npm run script:create-admin (cria o primeiro admin)
ADMIN_NAME=
ADMIN_PHONE=
ADMIN_PASSWORD=

# scripts/utils/add_shopkeeper_id_column.js — a qual lojista os motoboys que já
# existiam devem ficar ligados. Padrão: 2 (Vapor Fume).
BACKFILL_SHOPKEEPER_ID=2

# scripts/utils/make_phone_nullable.js — BACKUP=0 pula a cópia de segurança.
BACKUP=1

# scripts/utils/prune_app_logs.js — por quantos dias guardar os registros.
LOG_RETENTION_DAYS=90

# scripts/test/smoke-*.mjs (testes contra um servidor local)
BASE_URL=http://localhost:3007
API_KEY=
USER_ID=
MOTOBOY_ID=
SHOPKEEPER_ID=
ACTION_ID_VERIFY_2FA=
